{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "image",
    "imagePullPolicy",
    "vmNamespace",
    "sessionTTLMinutes",
    "operator",
    "goldenPVCs",
    "goldenPVCNamespace",
    "goldenPVCDiskSize",
    "maxActiveSessions",
    "serverPlacement",
    "operatorPlacement",
    "vmiPlacement",
    "storageClass",
    "blockedEgressCIDRs",
    "auth"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "vmNamespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "sessionTTLMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "goldenPVCs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "goldenPVCNamespace": {
      "type": "string"
    },
    "goldenPVCDiskSize": {
      "type": "string",
      "minLength": 1
    },
    "maxActiveSessions": {
      "type": "integer",
      "minimum": 1
    },
    "serverPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeSelector",
        "affinity",
        "tolerations"
      ],
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "operatorPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeSelector",
        "affinity",
        "tolerations"
      ],
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "vmiPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeSelector",
        "affinity",
        "tolerations"
      ],
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "storageClass": {
      "type": "string"
    },
    "blockedEgressCIDRs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedGroups"
      ],
      "properties": {
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
