{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string",
      "description": "Domain shared by Educates-generated URLs and the UDS tenant gateway.",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
      "default": "uds.dev"
    }
  },
  "required": ["domain"]
}
