{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "sessionsMaximum", "anonymousMaximum"],
      "properties": {
        "name": { "type": "string", "const": "uds-labs" },
        "host": { "type": "string", "const": "uds-labs-ui" },
        "sessionsMaximum": { "type": "integer", "minimum": 1 },
        "anonymousMaximum": { "type": "integer", "minimum": 1 }
      }
    },
    "workshop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "duration", "reserved", "expires"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 2 },
        "reserved": { "type": "integer", "minimum": 0 },
        "expires": { "type": "string", "minLength": 2 }
      }
    }
  },
  "required": ["image", "portal", "workshop"]
}
